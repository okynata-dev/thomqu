# Drop metadata: force JSON content-type (covers extensionless files like /meta/1) + open CORS so
# OpenSea / Base / marketplaces can fetch token metadata and images.
# NB: Cloudflare Pages reliably matches a single trailing splat — keep paths explicit per drop.

/drop/saylor/meta/*
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

/drop/saylor/img/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

/drop/saylor/collection.json
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *
